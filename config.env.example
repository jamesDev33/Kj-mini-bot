# =====================================================================
#  MIKEY PRIME — fichier de configuration
#  Copie ce fichier en "config.env" puis remplis/adapte les valeurs.
#  AUCUNE base de données externe (MongoDB ou autre) n'est nécessaire :
#  tout est stocké localement dans le dossier /database (fichiers JSON).
# =====================================================================

# --- Identité du bot / propriétaire ---
OWNER_NUMBER=242061691195
OWNER_NAME=Mikey prime
OWNER_EMAIL=
BOT_NAME=≛⃝꥓𝑴𝑰𝑲𝑬𝒀 ᵖʳᶦᵐᵉ𓆩ㅤ ⁹⁹⁹
PACK_AUTHER=MIKEY PRIME 999
PACK_NAME=MIKEY PRIME 999

# Numéro(s) "sudo"/dev supplémentaires (séparés par des virgules), en plus de OWNER_NUMBER.
DEV_NUMBER=
SUDO=

# --- Session WhatsApp (obtenue via le site de pairing / QR code au premier lancement) ---
SESSION_ID=

# --- Réglages généraux ---
PREFIX=.
WORKTYPE=public
PORT=5000
BRANCH=main
VERSION=MIKEY-PRIME-999 v1.0
THEME=GOJO
THUMB_IMAGE=https://telegra.ph/file/3c341828d86ee7a89c73f.jpg

# --- Comportement du bot (true/false) ---
AUTO_READ_STATUS=false
AUTO_REACTION=false
ALWAYS_ONLINE=false
READ_MESSAGE=false
AUTO_STATUS_SAVER=false
AUTO_BIO=false
DISABLE_PM=false
LEVEL_UP_MESSAGE=false

# --- Modération ---
ANTI_BAD_WORD=nbwoed
WARN_COUNT=3
ANTILINK_VALUES=chat.whatsapp.com
ANTILINK_ACTION=remove
FAKE_COUNTRY_CODE=971

# --- Liens / réseaux (facultatif, affichés dans certaines commandes) ---
GITHUB_URL=
BOT_LOCATION=
SOCIAL_URL=
WEBSITE_URL=

# --- Intégrations facultatives ---
OPENAI_API_KEY=

# --- Déploiement Heroku uniquement (laisser vide sinon) ---
HEROKU=false
HEROKU_API_KEY=
HEROKU_APP_NAME=
